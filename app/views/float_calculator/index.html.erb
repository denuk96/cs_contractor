<div class="page" data-controller="float-calculator">
  <div class="section-head" style="flex-direction: column; align-items: flex-start; gap: 6px">
    <span class="eyebrow eyebrow-brand">Tools</span>
    <h1>Adjusted Float Calculator</h1>
    <p class="prose" style="max-width: 70ch">
      A skin's float is read against its own min–max range, not the 0–1 scale — so a
      listing can wear far better, or worse, than its raw value suggests.
    </p>
  </div>

  <div class="modal-card" style="box-shadow: none">
    <%= render "shared/float_calculator_fields" %>
  </div>
</div>
