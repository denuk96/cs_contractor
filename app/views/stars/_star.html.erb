<%# locals: skin_item_id, starred %>
<%= turbo_frame_tag "star_skin_item_#{skin_item_id}", class: "d-inline" do %>
  <%= button_to skin_item_star_path(skin_item_id),
        method: starred ? :delete : :post,
        class: "star-btn #{'on' if starred}",
        form: { class: "d-inline" },
        title: starred ? "Remove from starred" : "Add to starred",
        aria: { label: starred ? "Remove from starred" : "Add to starred" } do %>
    <%= starred ? "★" : "☆" %>
  <% end %>
<% end %>
