<div class="page">
  <div class="feed-head">
    <div class="field" style="gap: 4px">
      <span class="eyebrow eyebrow-brand">Signals</span>
      <h1>Feed</h1>
    </div>
    <span class="feed-count">
      <%= number_with_delimiter(@feed_items.total_count) %>
      active <%= "entry".pluralize(@feed_items.total_count) %>
    </span>
    <div class="nav-spacer"></div>
    <div class="signal-pills">
      <%= link_to feed_path, class: "signal-pill #{"on" unless FeedItem.signal_types.key?(params[:signal_type])}" do %>
        All <span class="n"><%= feed_signal_counts.values.sum %></span>
      <% end %>
      <% FeedItem.signal_types.each_key do |signal_type| %>
        <%= link_to feed_path(signal_type: signal_type),
              class: "signal-pill #{"on" if params[:signal_type] == signal_type}" do %>
          <%= FeedItem::SIGNAL_LABELS.fetch(signal_type, signal_type.titleize) %>
          <span class="n"><%= feed_signal_counts.fetch(signal_type, 0) %></span>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @feed_items.any? %>
    <div class="feed-groups">
      <% @feed_items.group_by(&:occurred_on).each do |occurred_on, entries| %>
        <div class="feed-group">
          <div class="feed-divider">
            <span class="feed-divider-label"><%= feed_group_label(occurred_on) %></span>
            <span class="feed-divider-rule"></span>
            <span class="feed-divider-count"><%= entries.size %></span>
          </div>

          <div class="feed-cards">
            <% entries.each do |feed_item| %>
              <%
                skin_item = feed_item.skin_item
                slug = feed_signal_slug(feed_item.signal_type)
                rarity = skin_item.skin&.rarity || skin_item.rarity
                collection = skin_item.skin&.collection_name
                series = @chart_series[feed_item.id]
                points = series&.first&.dig(:data)
                latest = points&.last&.last
              %>
              <%= link_to skin_item_path(skin_item), class: "feed-card" do %>
                <span class="thumb feed-thumb">
                  <% if skin_item.image.present? %>
                    <%= image_tag skin_item.image, alt: skin_item.name, loading: "lazy" %>
                  <% else %>
                    <%= item_abbreviation(skin_item.name) %>
                  <% end %>
                </span>

                <span class="feed-body">
                  <span class="feed-line">
                    <span class="feed-name rar r-<%= rarity_slug(rarity) %>"><%= skin_item.name %></span>
                    <% if skin_item.wear.present? %>
                      <span class="feed-wear"><%= skin_item.wear %></span>
                    <% end %>
                    <% if rarity.present? %>
                      <span class="rar-tag r-<%= rarity_slug(rarity) %>"><%= rarity.to_s.sub(" Grade", "").upcase %></span>
                    <% end %>
                  </span>

                  <span class="feed-line">
                    <span class="zone zone-<%= slug %>"><%= feed_item.signal_label.upcase %></span>
                    <% if collection.present? %>
                      <span class="feed-collection"><%= collection %></span>
                    <% end %>
                  </span>

                  <p class="feed-headline"><%= feed_item.headline %></p>

                  <% if feed_item.details.present? %>
                    <span class="feed-details">
                      <% feed_item.details.each do |key, value| %>
                        <span class="kv-chip">
                          <span class="k"><%= key.to_s.humanize %></span>
                          <span class="v"><%= value %></span>
                        </span>
                      <% end %>
                    </span>
                  <% end %>
                </span>

                <span class="feed-spark">
                  <% if points.present? %>
                    <%= line_chart series, height: "60px", colors: [feed_signal_color(feed_item.signal_type)],
                          library: {
                            plugins: { legend: { display: false }, tooltip: { enabled: false } },
                            scales: { x: { display: false }, y: { display: false } },
                            elements: { point: { radius: 0 }, line: { borderWidth: 2, tension: 0.4, fill: false } },
                            layout: { padding: 2 }
                          } %>
                    <span class="feed-spark-caption">
                      <span class="feed-spark-name"><%= series.first[:name] %> · 14d</span>
                      <span class="feed-spark-value zone-text-<%= slug %>"><%= latest %></span>
                    </span>
                  <% end %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="feed-footer">
      <span>
        SHOWING <%= @feed_items.total_pages > 1 ? "#{@feed_items.offset_value + 1}–#{@feed_items.offset_value + @feed_items.size}" : "ALL #{@feed_items.total_count}" %>
        · 50 PER PAGE
      </span>
      <%= paginate @feed_items %>
      <% if (refreshed_at = FeedItem.maximum(:updated_at)) %>
        <span>LAST REFRESH <%= refreshed_at.utc.strftime("%Y-%m-%d %H:%M") %> UTC</span>
      <% end %>
    </div>
  <% else %>
    <div class="panel empty">
      <span class="empty-code">NO SIGNALS</span>
      <span class="empty-body">Nothing fired in the last refresh. Check back after the next data import.</span>
    </div>
  <% end %>
</div>
