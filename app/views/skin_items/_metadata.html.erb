<%# locals: skin_item, snapshot, requested_date, first_date, last_date %>
<%= turbo_frame_tag "skin_item_metadata" do %>
  <div class="metadata-body">
    <% if snapshot.nil? %>
      <span class="field-hint">No metadata recorded for this item yet.</span>
    <% else %>
      <%= form_with url: metadata_skin_item_path(skin_item), method: :get,
            class: "metadata-form", data: { controller: "autosubmit" } do |f| %>
        <label class="field">
          <span class="field-label">Snapshot date</span>
          <%= f.date_field :date, value: snapshot.date, min: first_date, max: last_date,
                class: "ctl ctl-num", data: { action: "change->autosubmit#submit" } %>
        </label>
        <%= f.submit "Show", class: "btn-outline", data: { autosubmit_target: "submit" } %>
        <% if snapshot.date != last_date %>
          <%= link_to "Latest", metadata_skin_item_path(skin_item), class: "btn-outline" %>
        <% end %>
      <% end %>

      <% if snapshot.date != requested_date %>
        <span class="metadata-warning">
          No snapshot on <%= requested_date %> — showing the closest available date.
        </span>
      <% end %>

      <% if snapshot.metadata.present? %>
        <pre class="metadata-json"><%= JSON.pretty_generate(snapshot.metadata) %></pre>
      <% else %>
        <span class="field-hint">No metadata recorded for this snapshot.</span>
      <% end %>
    <% end %>
  </div>
<% end %>
