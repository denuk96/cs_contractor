<%
  rarity = @skin_item.skin_rarity || @skin_item.rarity
  collection_name = item_collection_name(@skin_item)
  latest_history = @skin_item.skin_item_histories.order(date: :asc).last

  steam_url = "https://steamcommunity.com/market/listings/730/#{ERB::Util.url_encode(@skin_item.name)}"
  csfloat_params = { category: 0, type: "buy_now", market_hash_name: @skin_item.name }
  csfloat_params[:min_float] = @skin_item.skin.min_float if @skin_item.skin&.min_float.present?
  csfloat_params[:max_float] = @skin_item.skin.max_float if @skin_item.skin&.max_float.present?

  turnover_slug, turnover_label = turnover_zone(@current_turnover)

  divergence = @volume_change.present? && @price_change.present? &&
               @volume_change > 20 && @price_change.abs < 5

  # The squeeze chart keeps its own green/red/grey, which its own explanation
  # refers to by colour; everything else takes the shared series palette.
  series_colors = MarketOverviewHelper::SERIES_PALETTE
%>

<div class="page">
  <%# ------------------------------------------------------------- header -- %>
  <div class="item-header">
    <div class="item-id">
      <div class="item-title-row">
        <%= render "stars/star", skin_item_id: @skin_item.id, starred: @starred %>
        <h1 class="item-title rar r-<%= rarity_slug(rarity) %>"><%= @skin_item.name %></h1>
        <% if rarity.present? %>
          <span class="rar-tag r-<%= rarity_slug(rarity) %>"><%= rarity.to_s.sub(" Grade", "").upcase %></span>
        <% end %>
      </div>
      <div class="item-meta">
        <% if collection_name.present? %>
          <%= link_to collection_name, root_path(collection: [collection_name]) %>
          <span class="sep">·</span>
        <% end %>
        <span><%= @skin_item.wear || "—" %></span>
        <span class="sep">·</span>
        <span class="mono">float <%= float_range_with_wear_chance(@skin_item) %></span>
      </div>
    </div>

    <div class="nav-spacer"></div>

    <div class="item-price-block">
      <span class="item-price"><%= number_to_currency(@skin_item.latest_steam_price) %></span>
      <% if @price_change.present? %>
        <span class="delta <%= delta_class(@price_change) %>" style="font-size: 12px">
          <%= signed_percent(@price_change) %> · 7d
        </span>
      <% end %>
    </div>

    <div class="item-actions">
      <%= link_to steam_url, target: "_blank", rel: "noopener", class: "btn-ghost" do %>
        <i class="bi bi-steam"></i> View on Steam
      <% end %>
      <%= link_to "CSFloat", "https://csfloat.com/search?#{csfloat_params.to_query}",
            target: "_blank", rel: "noopener", class: "btn-ghost" %>
    </div>
  </div>

  <%# ------------------------------------------------------ verdict cards -- %>
  <div class="verdicts">
    <div class="verdict <%= @volume_change.present? ? (divergence ? "verdict-bad" : "verdict-good") : "verdict-dead" %>">
      <div class="verdict-head">
        <span class="verdict-name">Volume/Price Divergence</span>
        <%= info_dot("What is this?", "This signal looks for a spike in sales volume while the price stays flat. It's a strong indicator that a manipulator is quietly buying up supply without letting the price rise.") %>
      </div>
      <% if @volume_change.present? && @price_change.present? %>
        <span class="verdict-metric"><%= signed_percent(@volume_change, precision: 2) %></span>
        <div class="verdict-rows">
          <span class="kv-chip"><span class="k">Sales volume 7d</span><span class="v"><%= number_to_percentage(@volume_change, precision: 2) %></span></span>
          <span class="kv-chip"><span class="k">Price</span><span class="v"><%= number_to_percentage(@price_change, precision: 2) %></span></span>
        </div>
        <% if divergence %>
          <span class="verdict-zone">Divergence Detected (Strong Signal)</span>
          <p class="verdict-note">Sales volume is spiking, but the price is remaining flat. This is a strong indicator of accumulation.</p>
        <% else %>
          <span class="verdict-zone">Normal Market Activity</span>
          <p class="verdict-note">No significant divergence detected.</p>
        <% end %>
      <% else %>
        <span class="verdict-metric">—</span>
        <span class="verdict-zone">Not enough data</span>
        <p class="verdict-note">Divergence analysis needs at least eight daily snapshots.</p>
      <% end %>
    </div>

    <div class="verdict verdict-<%= turnover_slug == "organic" ? "good" : turnover_slug == "squeeze" ? "warn" : turnover_slug == "moon" ? "bad" : "dead" %>">
      <div class="verdict-head">
        <span class="verdict-name">Supply "Dry Up" (Turnover)</span>
        <%= info_dot("What is this?", "This measures how fast the available supply is being sold. A high turnover rate means demand is eating up supply, which can lead to a price spike (a 'squeeze').") %>
      </div>
      <span class="verdict-metric"><%= number_to_percentage(@current_turnover, precision: 2) %></span>
      <div class="verdict-rows">
        <% if latest_history %>
          <span class="kv-chip"><span class="k">Sold today</span><span class="v"><%= number_with_delimiter(latest_history.soldtoday) %></span></span>
          <span class="kv-chip"><span class="k">Offer volume</span><span class="v"><%= number_with_delimiter(latest_history.offervolume) %></span></span>
        <% end %>
      </div>
      <% if @current_turnover <= 5 %>
        <span class="verdict-zone">"Dead" Zone (0-5%)</span>
        <p class="verdict-note">Supply is massive; demand is low. Very hard to manipulate.</p>
      <% elsif @current_turnover <= 15 %>
        <span class="verdict-zone">"Organic" Zone (5-15%)</span>
        <p class="verdict-note">Healthy activity. Watch for a slow rise while price is stable (accumulation).</p>
      <% elsif @current_turnover <= 50 %>
        <span class="verdict-zone">"Squeeze" Zone (20-50%)</span>
        <p class="verdict-note">High Alert. A large portion of supply is vanishing daily. Potential for artificial buying.</p>
      <% else %>
        <span class="verdict-zone">"Moon" Zone (&gt;50%)</span>
        <p class="verdict-note">The market is broken. Demand is outpacing supply. Extreme volatility is likely.</p>
      <% end %>
    </div>

    <div class="verdict <%= @buy_wall_ratio.blank? ? "verdict-dead" : @buy_wall_ratio <= 10 ? "verdict-good" : "verdict-bad" %>">
      <div class="verdict-head">
        <span class="verdict-name">"Buy Wall" Ratio</span>
        <%= info_dot("What is this?", "This is the ratio of buy orders to sell listings. A high ratio (>50x) indicates a 'buy wall' where a large number of buy orders prevents the price from falling, suggesting someone has cornered the market.") %>
      </div>
      <% if @buy_wall_ratio.present? %>
        <span class="verdict-metric"><%= number_with_precision(@buy_wall_ratio, precision: 2) %>x</span>
        <div class="verdict-rows">
          <% if latest_history %>
            <span class="kv-chip"><span class="k">Buy orders</span><span class="v"><%= number_with_delimiter(latest_history.buyordervolume) %></span></span>
            <span class="kv-chip"><span class="k">Offer volume</span><span class="v"><%= number_with_delimiter(latest_history.offervolume) %></span></span>
          <% end %>
        </div>
        <% if @buy_wall_ratio <= 10 %>
          <span class="verdict-zone">Normal (5x-10x)</span>
          <p class="verdict-note">A healthy number of buy orders are present, providing a stable price floor.</p>
        <% else %>
          <span class="verdict-zone">PUMP ALERT (&gt;50x)</span>
          <p class="verdict-note">An extreme number of buy orders compared to sell listings. The market may be cornered.</p>
        <% end %>
      <% else %>
        <span class="verdict-metric">—</span>
        <span class="verdict-zone">Not enough data</span>
        <p class="verdict-note">Buy wall analysis needs a snapshot with a non-zero offer volume.</p>
      <% end %>
    </div>
  </div>

  <%# ------------------------------------------------------ item details -- %>
  <div class="section-head"><span class="section-title">Item Details</span></div>
  <div class="detail-cols">
    <div class="detail-col">
      <div class="detail-row">
        <span class="detail-key">Collection</span>
        <span class="detail-value">
          <%= collection_name.present? ? link_to(collection_name, root_path(collection: [collection_name])) : "—" %>
        </span>
      </div>
      <div class="detail-row">
        <span class="detail-key">Rarity</span>
        <span class="detail-value">
          <% if rarity.present? %>
            <span class="rar-tag r-<%= rarity_slug(rarity) %>"><%= rarity.to_s.sub(" Grade", "").upcase %></span>
          <% else %>—<% end %>
        </span>
      </div>
      <div class="detail-row">
        <span class="detail-key">Wear</span>
        <span class="detail-value"><%= @skin_item.wear || "—" %></span>
      </div>
      <div class="detail-row">
        <span class="detail-key">Float Range</span>
        <span class="detail-value mono"><%= float_range_with_wear_chance(@skin_item) %></span>
      </div>
      <div class="detail-row">
        <span class="detail-key">Current Price</span>
        <span class="detail-value mono" style="color: var(--text); font-weight: 500"><%= number_to_currency(@skin_item.latest_steam_price) %></span>
      </div>
    </div>

    <div class="detail-col">
      <div class="detail-row">
        <span class="detail-key">Turnover Rate</span>
        <span class="detail-value">
          <span class="mono"><%= number_to_percentage(@current_turnover, precision: 1) %></span>
          <span class="zone zone-<%= turnover_slug %>"><%= turnover_label %> ZONE</span>
        </span>
      </div>
      <div class="detail-row">
        <span class="detail-key">Buy Order Vol</span>
        <span class="detail-value mono">
          <%= latest_history&.buyordervolume.present? ? number_with_delimiter(latest_history.buyordervolume) : "—" %>
        </span>
      </div>
      <div class="detail-row">
        <span class="detail-key">Buy Wall Ratio</span>
        <span class="detail-value">
          <% if @buy_wall_ratio.present? %>
            <span class="mono <%= "wall-value pump" if @buy_wall_ratio >= 50 %>"><%= number_with_precision(@buy_wall_ratio, precision: 2) %>x</span>
          <% else %>—<% end %>
        </span>
      </div>
      <div class="detail-row">
        <span class="detail-key">Total Quantity</span>
        <span class="detail-value mono">
          <%= latest_history&.all_markets_quantity.present? ? number_with_delimiter(latest_history.all_markets_quantity) : "—" %>
        </span>
      </div>
    </div>
  </div>

  <%# -------------------------------------------------- prices & variants -- %>
  <div class="section-head">
    <span class="section-title">Prices &amp; Variants</span>
    <%= info_dot("What is this?", "Every market variant of this skin in one place. Pick a wear to jump to that listing. With the CS2 Souvenir update these can now be crafted, so a Souvenir counterpart is shown alongside the Normal and StatTrak™ prices.") %>
  </div>

  <div class="variants">
    <div class="variant-image">
      <% if @skin_image.present? %>
        <%= image_tag @skin_image, alt: @skin_item.name, loading: "lazy" %>
      <% else %>
        <span class="mono" style="color: var(--t8)"><%= item_abbreviation(@skin_item.name) %></span>
      <% end %>
    </div>

    <div class="variant-rows">
      <% if @variant_rows.any? %>
        <% @variant_rows.each do |row| %>
          <div>
            <span class="variant-row-label"><%= row[:label] %></span>
            <div class="variant-grid" style="--wears: <%= @variant_wears.size %>">
              <% @variant_wears.each do |wear| %>
                <% if (variant = row[:items_by_wear][wear]) %>
                  <%= link_to skin_item_path(variant),
                        class: "variant-cell #{"current" if variant.id == @skin_item.id}",
                        "aria-current": (variant.id == @skin_item.id ? "true" : nil) do %>
                    <span class="variant-wear"><%= wear_abbreviation(wear) || wear %></span>
                    <span class="variant-price"><%= variant.latest_steam_price ? number_to_currency(variant.latest_steam_price) : "—" %></span>
                  <% end %>
                <% else %>
                  <div class="variant-cell missing">
                    <span class="variant-wear"><%= wear_abbreviation(wear) || wear %></span>
                    <span class="variant-price">&ndash;</span>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <span class="field-hint">No market variants available for this skin yet.</span>
      <% end %>
    </div>
  </div>

  <%# --------------------------------------------------- signal dashboards -- %>
  <%= render layout: "skin_items/dashboard", locals: {
        number: "0", title: 'The "Supply Runover" Dashboard', subtitle: "supply vs demand",
        tip_title: "Supply vs Demand",
        tip_body: "Directly compares the daily Sold Volume against the available Offer Volume. If the Sold line consistently approaches or crosses the Offers line, a supply squeeze is imminent.",
        chart_id: "supply-runover-chart" } do %>
    <%= line_chart pinned_to_axes(@supply_runover_data), id: "supply-runover-chart", height: "320px", colors: series_colors,
          library: chart_defaults.merge(scales: named_axes({
            "volume-axis": chart_axis(title: "Volume", unit: :integer, position: "left")
          })) %>
  <% end %>

  <%= render layout: "skin_items/dashboard", locals: {
        number: "1", title: 'The "Accumulation" Dashboard', subtitle: "early warning",
        tip_title: "The X-Cross Pattern",
        tip_body: "Look for the 'X-Cross': Offer Volume (Supply) trends DOWN while Buy Orders (Demand) trend UP. If the Price stays FLAT during this, it's a strong signal that someone is secretly absorbing supply.",
        chart_id: "accumulation-chart" } do %>
    <%= line_chart pinned_to_axes(@accumulation_data), id: "accumulation-chart", height: "320px", colors: series_colors,
          library: chart_defaults.merge(scales: named_axes({
            "volume-axis": chart_axis(title: "Volume", unit: :integer, position: "left"),
            "price-axis": chart_axis(title: "Price (USD)", unit: :currency, position: "right", secondary: true)
          })) %>
  <% end %>

  <%= render layout: "skin_items/dashboard", locals: {
        number: "2", title: 'The "Elasticity" Dashboard', subtitle: "the trigger",
        tip_title: "The Tension Spike",
        tip_body: "Look for the 'Tension' Spike: The Buy Wall Ratio spikes massively (e.g., >50x) while the Turnover Rate is moderate. If Turnover then jumps, the price has nowhere to go but up.",
        chart_id: "elasticity-chart" } do %>
    <%= line_chart pinned_to_axes(@elasticity_data), id: "elasticity-chart", height: "320px", colors: series_colors,
          library: chart_defaults.merge(scales: named_axes({
            "ratio-axis": chart_axis(title: "Buy Wall Ratio", unit: :ratio, position: "left"),
            "percent-axis": chart_axis(title: "Turnover Rate (%)", unit: :percent, position: "right", secondary: true)
          })) %>
  <% end %>

  <%= render layout: "skin_items/dashboard", locals: {
        number: "3", title: 'The "Fakeout" Dashboard', subtitle: "the trap",
        tip_title: "The Hollow Volume",
        tip_body: "Look for 'Hollow' Volume: Sold Volume is exploding, but the Price is barely moving. This is a classic sign of wash trading to create fake hype. Real demand always moves price.",
        chart_id: "fakeout-chart" } do %>
    <%= line_chart pinned_to_axes(@fakeout_data), id: "fakeout-chart", height: "320px", colors: series_colors,
          library: chart_defaults.merge(scales: named_axes({
            "volume-axis": chart_axis(title: "Sold Volume", unit: :integer, position: "left"),
            "price-axis": chart_axis(title: "Price (USD)", unit: :currency, position: "right", secondary: true)
          })) %>
  <% end %>

  <%= render layout: "skin_items/dashboard", locals: {
        number: "4", title: 'The "Squeeze" Chart', subtitle: "god mode",
        tip_title: "The 'Go' Signal",
        tip_body: "The 'Go' Signal: When the Green Line (Buy Wall) is at an All-Time High and the Red Line (Supply) is at an All-Time Low, the next bar of Grey (Volume) will cause a vertical price spike.",
        chart_id: "squeeze-chart" } do %>
    <%= line_chart pinned_to_axes(@squeeze_data), id: "squeeze-chart", height: "320px",
          library: chart_defaults.merge(scales: named_axes({
            "ratio-axis": chart_axis(title: "Buy Wall Ratio", unit: :ratio, position: "left"),
            "volume-axis": chart_axis(title: "Volume", unit: :integer, position: "right", secondary: true)
          })) %>
  <% end %>

  <%# ------------------------------------------------------- cross-market -- %>
  <div class="section-head">
    <span class="section-title">Cross-Market Discrepancy</span>
    <span class="section-sub">vs Steam</span>
    <%= info_dot("Cross-Market Disconnect", "How far each third-party market's lowest offer sits from Steam in the latest snapshot. Cheaper than Steam reads green; a large gap can signal a Steam-side pump.") %>
  </div>

  <% if @price_discrepancy.present? && @steam_reference_price.to_f > 0 %>
    <div class="panel" style="overflow: hidden">
      <div style="display: flex; align-items: baseline; gap: 8px; padding: 12px 14px; border-bottom: 1px solid var(--line)">
        <span class="eyebrow">Steam reference</span>
        <span class="mono" style="font-size: 15px; color: var(--text)">$<%= number_with_precision(@steam_reference_price, precision: 2) %></span>
        <% if @latest_history_date %>
          <span class="mono" style="font-size: 11px; color: var(--t8)">snapshot <%= @latest_history_date %></span>
        <% end %>
      </div>
      <table class="market-table">
        <thead>
          <tr>
            <th>Market</th>
            <th>Price</th>
            <th>Qty</th>
            <th>Δ vs Steam</th>
          </tr>
        </thead>
        <tbody>
          <% @price_discrepancy.each do |row| %>
            <tr>
              <td><%= row[:source].titleize %></td>
              <td>$<%= number_with_precision(row[:price], precision: 2) %></td>
              <td><%= number_with_delimiter(row[:quantity]) %></td>
              <td class="delta <%= row[:diff_percent].nil? ? "flat" : delta_class(row[:diff_percent], polarity: :down_is_good) %>" style="font-size: 12px">
                <%= row[:diff_percent] ? format("%+.1f%%", row[:diff_percent]) : "—" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="prose">No cross-market price data yet. Run <code>rake import:backfill_market_prices</code> or wait for the next import.</p>
  <% end %>

  <div class="section-head">
    <span class="section-title">Cross-Market Prices</span>
    <span class="section-sub">day by day</span>
    <%= info_dot("All Markets", "Lowest offer per market, day by day, including Steam. Diverging lines show where one market is leading or lagging the others.") %>
  </div>

  <% if @market_price_data.present? %>
    <div class="dash-panel" data-controller="chart-legend" data-chart-legend-chart-id-value="cross-market-chart">
      <div class="chart-legend" data-chart-legend-target="list"></div>
      <%= line_chart @market_price_data, id: "cross-market-chart", height: "320px", colors: series_colors,
            library: chart_defaults.merge(scales: named_axes({
              y: chart_axis(title: "Price (USD)", unit: :currency, position: "left")
            })) %>
    </div>
  <% else %>
    <p class="prose">No cross-market price history yet.</p>
  <% end %>

  <%# --------------------------------------------------- snapshot metadata -- %>
  <details class="panel metadata-card">
    <summary>
      <span class="chev">&#9656;</span>
      Snapshot Metadata
    </summary>
    <%= render "skin_items/metadata", @metadata_locals %>
  </details>

  <div>
    <%= link_to "← Back to Trending", root_path, class: "btn-outline" %>
  </div>
</div>
