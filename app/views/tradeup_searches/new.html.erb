<div class="page">
  <div class="section-head" style="flex-direction: column; align-items: flex-start; gap: 5px">
    <span class="eyebrow eyebrow-brand">Contracts</span>
    <h1>Tradeup Finder</h1>
    <p class="prose" style="max-width: 78ch">
      Sweeps every collection × wear × StatTrak combination for a ten-input contract whose
      expected value clears its cost. Expected value is
      <span class="mono" style="color: var(--text2)">Σ probability × price × fee multiplier</span>;
      filler slots dilute each outcome and add a trash outcome of their own.
    </p>
  </div>

  <%= form_with url: tradeup_searches_path, method: :post, data: { turbo: false } do |f| %>
    <%= hidden_field_tag "tradeup_search[skip_if_price_missing]", "0" %>
    <%= hidden_field_tag "tradeup_search[consider_float]", "0" %>

    <div class="params-card">
      <div class="params-grid">
        <label class="field">
          <span class="field-label">Fee multiplier</span>
          <%= f.number_field :price_fee_multiplier, value: @params[:price_fee_multiplier],
                class: "ctl ctl-num", step: 0.01, min: 0, max: 1,
                name: "tradeup_search[price_fee_multiplier]" %>
          <span class="field-hint">e.g. 0.85 for Steam 15% fee</span>
        </label>

        <label class="field">
          <span class="field-label">Max cost ($)</span>
          <%= f.number_field :max_cost, value: @params[:max_cost],
                class: "ctl ctl-num", step: 1, min: 0,
                name: "tradeup_search[max_cost]" %>
          <span class="field-hint">Ceiling on the ten inputs</span>
        </label>

        <label class="field">
          <span class="field-label">Min profit ($)</span>
          <%= f.number_field :min_profit, value: @params[:min_profit],
                class: "ctl ctl-num", step: 0.5, min: 0,
                name: "tradeup_search[min_profit]" %>
          <span class="field-hint">Below this, the contract is dropped</span>
        </label>

        <label class="field">
          <span class="field-label">Cheapest fill count</span>
          <%= f.number_field :cheapest_fill_count, value: @params[:cheapest_fill_count],
                class: "ctl ctl-num", step: 1, min: 0, max: 9,
                name: "tradeup_search[cheapest_fill_count]" %>
          <span class="field-hint">Filler slots from any collection</span>
        </label>

        <label class="field">
          <span class="field-label">Min outcome lose (%)</span>
          <%= f.number_field :minimum_outcome_lose, value: @params[:minimum_outcome_lose],
                class: "ctl ctl-num", step: 5, min: 0, max: 100,
                name: "tradeup_search[minimum_outcome_lose]" %>
          <span class="field-hint">0 = allow any loss</span>
        </label>

        <label class="field">
          <span class="field-label">Results per collection</span>
          <%= f.number_field :limit_per_collection, value: @params[:limit_per_collection],
                class: "ctl ctl-num", step: 1, min: 1,
                name: "tradeup_search[limit_per_collection]" %>
          <span class="field-hint">Caps how many survive per collection</span>
        </label>

        <label class="field">
          <span class="field-label">Max unique inputs</span>
          <%= f.number_field :max_unique_inputs, value: @params[:max_unique_inputs],
                class: "ctl ctl-num", step: 1, min: 1, max: 10,
                name: "tradeup_search[max_unique_inputs]" %>
          <span class="field-hint">Distinct skins across the ten slots</span>
        </label>

        <label class="field">
          <span class="field-label">From rarity</span>
          <%= f.select :from_rarity,
                options_for_select([["All rarities", ""]] + TradeupSearchesController::RARITY_OPTIONS.map { |r| [r, r] }, @params[:from_rarity]),
                {}, class: "ctl", name: "tradeup_search[from_rarity]" %>
          <span class="field-hint">The input tier to contract up from</span>
        </label>

        <label class="field">
          <span class="field-label">Filler strategy</span>
          <%= f.select :filler_strategy,
                options_for_select([["Cheapest any", "cheapest_any"], ["Mixed high wear", "mixed_high_wear"]], @params[:filler_strategy]),
                {}, class: "ctl", name: "tradeup_search[filler_strategy]" %>
          <span class="field-hint">How filler slots are picked</span>
        </label>

        <label class="field">
          <span class="field-label">Outcome price type</span>
          <%= f.select :outcome_price_type,
                options_for_select([["Latest Steam price", "latest_steam_price"], ["Latest order price", "latest_steam_order_price"]], @params[:outcome_price_type]),
                {}, class: "ctl", name: "tradeup_search[outcome_price_type]" %>
          <span class="field-hint">Which quote values the outcomes</span>
        </label>

        <div class="field" style="justify-content: flex-end; gap: 6px">
          <label class="check">
            <%= check_box_tag "tradeup_search[skip_if_price_missing]", "1",
                  @params[:skip_if_price_missing].to_s == "1" %>
            Skip if price missing
          </label>
          <label class="check">
            <%= check_box_tag "tradeup_search[consider_float]", "1",
                  @params[:consider_float].to_s == "1" %>
            Consider float
          </label>
        </div>
      </div>

      <div class="params-footer">
        <%= button_tag type: :submit, name: nil, class: "btn-primary-brand" do %>
          <i class="bi bi-search"></i> Find profitable contracts
        <% end %>
        <%= link_to "Reset", new_tradeup_search_path, class: "btn-outline" %>
        <div class="nav-spacer"></div>
        <span class="params-id">
          <%= pluralize(@recent_searches.size, "recent search") %>
        </span>
      </div>
    </div>
  <% end %>

  <% if @recent_searches.any? %>
    <div class="section-head"><span class="section-title">Recent searches</span></div>
    <div class="panel" style="overflow: auto">
      <table class="recent-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Status</th>
            <th>Rarity</th>
            <th>Fee</th>
            <th>Max cost</th>
            <th>Min profit</th>
            <th>Fill</th>
            <th>Contracts</th>
            <th>Started</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @recent_searches.each do |search| %>
            <% p = JSON.parse(search.params_json) rescue {} %>
            <tr>
              <td class="num">#<%= search.id %></td>
              <td>
                <% if search.done? %>
                  <span class="status-pill status-done">done</span>
                <% elsif search.status == "running" %>
                  <span class="status-pill status-running"><%= search.completed_jobs %>/<%= search.total_jobs %></span>
                <% else %>
                  <span class="status-pill status-queued"><%= search.status %></span>
                <% end %>
              </td>
              <td><%= p["from_rarity"].presence || "all" %></td>
              <td class="num"><%= p["price_fee_multiplier"] %></td>
              <td class="num">$<%= p["max_cost"] %></td>
              <td class="num">$<%= p["min_profit"] %></td>
              <td class="num"><%= p["cheapest_fill_count"] %></td>
              <td class="num"><%= search.tradeup_contracts.count %></td>
              <td class="num"><%= search.created_at.strftime("%m/%d %H:%M") %></td>
              <td><%= link_to "View", tradeup_search_path(search), class: "btn-outline" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
