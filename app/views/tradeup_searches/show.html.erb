<% unless @search.done? %>
  <meta http-equiv="refresh" content="2">
<% end %>

<%
  fill_count = (JSON.parse(@search.params_json)["cheapest_fill_count"].to_i rescue 0)
  fee = (JSON.parse(@search.params_json)["price_fee_multiplier"] rescue nil)
%>

<div class="page">
  <div class="section-head">
    <div class="field" style="gap: 4px">
      <span class="eyebrow eyebrow-brand">Contracts</span>
      <h1>Tradeup Search #<%= @search.id %></h1>
    </div>
    <div class="nav-spacer"></div>
    <%= link_to "New search", new_tradeup_search_path, class: "btn-outline" %>
  </div>

  <%# The sweep runs one job per collection x wear x StatTrak combination, and
      results land as each finishes — so the bar is the only thing that says
      whether an empty list means "none" or "not yet". %>
  <% if @search.total_jobs %>
    <div class="progress-block">
      <div class="progress-line">
        <span class="progress-label">
          <% if @search.done? %>
            Done — <%= pluralize(@contracts.size, "contract") %> found
          <% else %>
            Running — <%= @search.completed_jobs %>/<%= @search.total_jobs %> jobs ·
            <%= @contracts.size %> found so far
          <% end %>
        </span>
        <span class="progress-pct"><%= @search.progress_pct %>%</span>
      </div>
      <div class="progress-track">
        <div class="progress-fill <%= "running" unless @search.done? %>" style="width: <%= @search.progress_pct %>%"></div>
      </div>
    </div>
  <% else %>
    <div class="panel empty">
      <span class="empty-code">QUEUING</span>
      <span class="empty-body">Queuing jobs…</span>
    </div>
  <% end %>

  <% if @contracts.empty? && @search.done? %>
    <div class="panel empty">
      <span class="empty-code">NO CONTRACTS</span>
      <span class="empty-body">No profitable contracts found with these parameters.</span>
      <%= link_to "Adjust parameters", new_tradeup_search_path, class: "btn-outline", style: "margin-top: 6px" %>
    </div>
  <% end %>

  <% if @contracts.any? %>
    <div class="contracts">
      <% @contracts.each_with_index do |tradeup_contract, index| %>
        <% c = tradeup_contract.parsed_data %>
        <div class="contract">
          <div class="contract-head">
            <span class="contract-rank">#<%= index + 1 %></span>
            <span class="contract-collection"><%= c[:collection] %></span>
            <span class="contract-wear"><%= c[:wear] %></span>
            <span class="contract-path">
              <span class="rar r-<%= rarity_slug(c[:from_rarity]) %>"><%= c[:from_rarity].to_s.sub(" Grade", "").upcase %></span>
              <span class="arrow">&rarr;</span>
              <span class="rar r-<%= rarity_slug(c[:to_rarity]) %>"><%= c[:to_rarity].to_s.sub(" Grade", "").upcase %></span>
            </span>

            <div class="nav-spacer"></div>

            <div class="contract-stats">
              <span class="stat-chip"><span class="k">cost</span><span class="v">$<%= c[:cost].round(2) %></span></span>
              <span class="stat-chip ev"><span class="k">EV</span><span class="v">$<%= c[:expected_value].round(2) %></span></span>
              <span class="stat-chip profit"><span class="k">profit</span><span class="v">$<%= c[:profit].round(2) %></span></span>
              <span class="stat-chip range">
                <span class="k">min–max</span>
                <span class="v">$<%= c[:minimal_expected_value].round(2) %> – $<%= c[:maximum_expected_value].round(2) %></span>
              </span>
            </div>
          </div>

          <div class="contract-body">
            <div class="contract-col">
              <span class="contract-col-title">Input stack (10 items)</span>
              <% c[:stack].each do |s| %>
                <div class="stack-row">
                  <span class="qty-pill"><%= s[:qty] %>x</span>
                  <%= link_to s[:item_name], skin_item_path(s[:item_id]), class: "stack-name" %>
                  <% if s[:souvenir] %><span class="sv-tag">SV</span><% end %>
                  <span class="stack-price">$<%= s[:item_price] %></span>
                </div>
              <% end %>
            </div>

            <div class="contract-col">
              <span class="contract-col-title">Possible outcomes</span>
              <% c[:outcomes].each do |o| %>
                <%
                  prob = o[:probability] * 100
                  prob -= prob / 100.0 * (fill_count * 10) if fill_count > 0
                %>
                <div class="stack-row">
                  <span class="pill-outline"><%= prob.round(1) %>%</span>
                  <%= link_to o[:item_name], skin_item_path(o[:item_id]), class: "stack-name" %>
                  <span class="stack-price">$<%= o[:price] %></span>
                </div>
              <% end %>

              <% if fill_count > 0 %>
                <div class="stack-row trash">
                  <span class="pill-outline" style="color: var(--bad); border-color: var(--bad)"><%= (fill_count * 10.0).round(1) %>%</span>
                  <span class="stack-name">Trash outcome</span>
                  <span class="stack-price">$0</span>
                </div>
              <% end %>

              <p class="contract-note">
                EV is <code>Σ probability × price<%= " × #{fee}" if fee %></code>.
                <% if fill_count > 0 %>
                  The <%= fill_count %> filler <%= "slot".pluralize(fill_count) %> dilute every outcome by
                  <%= (fill_count * 10.0).round(1) %>% and contribute that share as a trash outcome worth $0.
                <% end %>
              </p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
